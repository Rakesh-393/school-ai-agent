# ---------------------------------------------------------------
# 1. Pick your LLM provider: groq | gemini | ollama | anthropic
# ---------------------------------------------------------------
LLM_PROVIDER=mock          # runs with NO api key. switch to "groq" once you set GROQ_API_KEY below.

# --- groq (FREE, recommended to start) -> https://console.groq.com/keys
GROQ_API_KEY=gsk_xxxxxxxxxxxxxxxxxxxx
GROQ_MODEL=llama-3.3-70b-versatile

# --- google gemini (FREE tier) -> https://aistudio.google.com/apikey
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash

# --- ollama (100% local/offline) -> https://ollama.com  then: ollama pull qwen2.5:7b
OLLAMA_BASE_URL=http://localhost:11434/v1
OLLAMA_MODEL=qwen2.5:7b

# --- anthropic (the paid upgrade path) -> https://console.anthropic.com
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-5

# ---------------------------------------------------------------
# 2. App config
# ---------------------------------------------------------------
SECRET_KEY=change-me-in-production
DATABASE_URL=sqlite:///school.db
CHROMA_DIR=instance/chroma
FLASK_DEBUG=1
