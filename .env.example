# ---------------------------------------------------------------
# 1. Pick your LLM provider: groq | gemini | ollama | anthropic
# ---------------------------------------------------------------
LLM_PROVIDER=mock          # runs with NO api key. switch to "groq" once you set GROQ_API_KEY below.

# --- groq (FREE, recommended to start) -> https://console.groq.com/keys
GROQ_API_KEY=gsk_xxxxxxxxxxxxxxxxxxxx
GROQ_MODEL=openai/gpt-oss-120b
# gpt-oss are reasoning models. "low" is ~7x faster for tool routing, same accuracy.
GROQ_REASONING_EFFORT=low

# --- google gemini (FREE tier) -> https://aistudio.google.com/apikey
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash

# --- ollama (100% local/offline) -> https://ollama.com  then: ollama pull qwen2.5:7b
OLLAMA_BASE_URL=http://localhost:11434/v1
OLLAMA_MODEL=qwen2.5:7b

# --- anthropic (the paid upgrade path) -> https://console.anthropic.com
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-5

# ---------------------------------------------------------------
# 2. App config
# ---------------------------------------------------------------
SECRET_KEY=change-me-in-production
DATABASE_URL=sqlite:///school.db   # ignored when DB_BACKEND is set below
CHROMA_DIR=instance/chroma
FLASK_DEBUG=1

# ---------------------------------------------------------------
# 3. Database
# ---------------------------------------------------------------
# Leave DB_BACKEND blank (or "sqlite") for the bundled SQLite file.
# Set it to "mssql" to use SQL Server, then fill in the block below.
# DB_BACKEND wins over DATABASE_URL, so you do not have to delete that line.
# Which agent to run:
#   school = the bundled SQLite demo school
#   hrms   = read-only tools over an existing HR database
AGENT_DOMAIN=school

DB_BACKEND=

# --- SQL Server (only read when DB_BACKEND=mssql) ---
# HOST is the machine. Use ONE of INSTANCE or PORT, never both:
#   default instance on a port ->  MSSQL_HOST=10.0.0.5   MSSQL_PORT=1433
#   named instance            ->  MSSQL_HOST=10.0.0.5   MSSQL_INSTANCE=SQLEXPRESS
MSSQL_HOST=localhost
MSSQL_INSTANCE=
MSSQL_PORT=
MSSQL_DATABASE=school

# Leave USER empty to log in as the Windows account running the app.
# Fill both in for SQL Server authentication. No quotes; @ ; { } are all fine.
MSSQL_USER=
MSSQL_PASSWORD=

# Blank picks the newest ODBC driver installed on this machine.
MSSQL_DRIVER=
MSSQL_ENCRYPT=yes
# Set to no only against a server with a certificate your machine trusts.
MSSQL_TRUST_SERVER_CERTIFICATE=yes
MSSQL_TIMEOUT=10

# Safety valve. The app creates its own tables on SQLite only. Set this to
# yes ONLY if the agent owns the SQL Server database you pointed it at --
# it lets create_all() and `seed-db --reset` (which DROPS tables) run there.
DB_CREATE_TABLES=
